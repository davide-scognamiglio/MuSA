/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the family-mode test on the Sarek path
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The family fixture through --vcf_format sarek, whose GATK hard filter sorts the sample
    columns by name. The samplesheet order is proband P1, mother M1, father F1, which sorts to
    F1, M1, P1: the proband last, the parents in the other order. Every member must still get
    its own genotypes. Use as follows, then check the result:
        nextflow run MuSA -profile test_family_sarek,docker --outdir <OUTDIR> --data_dir <DATA_DIR>
        python3 tests/check_family_fixture.py --maf <OUTDIR>/<date>/FAM/FAM.raw.maf \
            --vcf <family_fixture.vcf.gz>
----------------------------------------------------------------------------------------
*/

includeConfig 'test_family.config'

params {
    config_profile_name        = 'Family test profile, Sarek path'
    config_profile_description = 'Trio on a joint-called VCF through the GATK hard filter, which reorders samples'
    vcf_format                 = 'sarek'
}

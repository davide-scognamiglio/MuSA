/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the family-mode test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A trio (proband, mother, father) on one joint-called VCF: 15 GRCh38 sites from the 1000
    Genomes trio SH006 with written genotypes, DP, GQ and AD covering every Inheritance and
    Inheritance_check outcome, chrX in a male proband and PAR1. Use as follows:
        nextflow run MuSA -profile test_family,docker --outdir <OUTDIR> --data_dir <DATA_DIR>
    As with -profile test, --data_dir must be a data directory built by --workflow setup.
----------------------------------------------------------------------------------------
*/

includeConfig 'test.config'

params {
    config_profile_name        = 'Family test profile'
    config_profile_description = 'Trio on a joint-called VCF: inheritance, segregation, compound heterozygosity'
    input                      = "${projectDir}/tests/data/samplesheet_family.csv"
}

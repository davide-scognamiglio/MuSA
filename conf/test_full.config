/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run MuSA -profile test_full,docker --outdir <OUTDIR> \
            --data_dir <DATA_DIR> --annovar_software_dir <ANNOVAR_DIR>

    Same caveat as conf/test.config: --data_dir and --annovar_software_dir must be supplied,
    because MuSA's reference bundle is built locally by `--workflow setup` rather than fetched
    per run. This profile differs from `test` only in running the full plugin suite, which is the
    expensive path worth exercising end to end.
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    input           = "${projectDir}/tests/data/samplesheet.csv"
    outdir          = 'output'
    workflow        = 'annotate'
    vcf_format      = 'multicaller'
    // The distinguishing feature of the full test: exercises every wired VEP plugin, which
    // requires the extended setup (--download_vep_plugins true) to have been run.
    use_vep_plugins = true
    n_core          = 8
}

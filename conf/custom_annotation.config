params {
    // ------- BASIC PARAMS - MANDATORY -------------------------------------------------------------------------------
    input                      = "tests/data/samplesheet.csv"
    outdir                     = "musa_output"
    workflow                   = "annotate" // type of analysis: germline, setup, benchmark. If not defined, benchmark is used   
    vcf_format                 = "multicaller" // sarek or multicaller
    center                     = ""
    // ------- GENEBE PARAMS - REQUIRED IF OFFLINE == FALSE -----------------------------------------------------------
    gb_user                    = "REDACTED-EMAIL"
    gb_api_key                 = "REDACTED-ROTATED-GENEBE-KEY"
    http_proxy                 = "REDACTED-INTERNAL-PROXY"
    https_proxy                = "REDACTED-INTERNAL-PROXY"
    // ------- VEP PARAMS ---------------------------------------------------------------------------------------------
    n_core                     = "16"
    use_vep_plugins            = false
}


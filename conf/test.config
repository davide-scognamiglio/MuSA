/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run MuSA -profile test,docker --outdir <OUTDIR> \
            --data_dir <DATA_DIR> --annovar_software_dir <ANNOVAR_DIR>

    NOTE: unlike most nf-core pipelines, `-profile test` alone is not self-contained. MuSA
    annotates against a ~250 GB local reference bundle (VEP cache, dbNSFP, ANNOVAR databases,
    ClinVar/ClinGen, reference genome) built by `--workflow setup`. That cannot be shipped in a
    test profile, so --data_dir and --annovar_software_dir must still be supplied. Only the input
    VCF is remote.
----------------------------------------------------------------------------------------
*/

process {
    // Sized for a standard GitHub Actions runner (4 cpu / 16 GB).
    //
    // Do NOT copy this block into a production config. resourceLimits caps every process, and
    // RENOVO_ANNOTATE_VCF declares 36.GB with a retry that doubles to 72.GB precisely because it
    // OOM-killed at 18 GB and 36 GB on real exomes (see modules/local/renovo_annotate_vcf). A
    // 12 GB ceiling would silently reintroduce that OOM. It is safe here only because the test
    // dataset is a single-variant VCF.
    resourceLimits = [
        cpus: 4,
        memory: '12.GB',
        time: '2.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Single-variant NA12877 VCF from the MuSA test-datasets repository.
    input           = "${projectDir}/tests/data/samplesheet.csv"
    outdir          = 'output'
    workflow        = 'annotate'
    vcf_format      = 'multicaller'
    use_vep_plugins = false
    n_core          = 4
}


process.executor = "local"
// Every MuSA module declares its own container. Clear any default a user set for all pipelines in
// ~/.nextflow/config (e.g. process.container = "ubuntu:22.04"): MuSA never uses it, and nf-schema's
// paramsSummaryLog crashes on a single default container ("Cannot cast object ... to class
// java.util.Map"), so it would stop MuSA before the first task.
process.container = null
plugins {
  id 'nf-schema@2.7.3'
}

/**************************** ANNOTATE parameters ****************************/
params {
    build                      = "hg38"
    // Pinned to the test-datasets commit this release was built for, not main: main follows the newest
    // MuSA (VEP cache 116+, new entries), and 1.0 runs VEP 115, which needs the release-115 cache.
    dbs_manifest               = "https://raw.githubusercontent.com/davide-scognamiglio/test-datasets/13b203db6d3f17da44a1e3c943f37e20ff25b79b/dbs_manifest.yaml"
    // dbNSFP is distributed only to registered users (dbnsfp.org: institutional email, then a
    // personal download link), so the public manifest carries no URL for it. `setup` needs one of:
    //   --dbnsfp_url  your own dbNSFP download link (kept out of the parameter summary)
    //   --dbnsfp_zip  the dbNSFP zip already on disk (checked against the manifest's SHA-256)
    dbnsfp_url                 = null
    dbnsfp_zip                 = null
    input                      = null
    outdir                     = null
    workflow                   = null 
    vcf_format                 = null
    offline                    = true
    center                     = null
    annovar_software_dir       = null
    skip_bcftools              = false
    max_freq                   = null
    drop_benign                = false
    skip_genebe                = false
    panel                      = null
    // ------- GENEBE PARAMS - REQUIRED IF OFFLINE == FALSE -----------------------------------------------------------
    gb_user                    = null
    gb_api_key                 = null
    http_proxy                 = null
    https_proxy                = null
    // ------- VEP PARAMS ---------------------------------------------------------------------------------------------
    download_vep_plugins       = false
    use_vep_plugins            = false
    data_dir                   = null
    n_core                     = 8
    // ---------- OTHER -----------------------------------------------------------------------------------------------
    igenomes_base = 's3://ngi-igenomes/igenomes/'
    custom_config_version = 'master'
    custom_config_base = 'https://raw.githubusercontent.com/nf-core/configs/master'
    publish_dir_mode = 'copy'
    validate_params = true
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/davide-scognamiglio/test-datasets/'
    email = null
    genome = null
    fasta = null
    igenomes_ignore = false

    config_profile_name = null
    config_profile_description = null
    config_profile_contact = null
    config_profile_url = null

    version = false
    help = false
    email_on_fail = null
    plaintext_email = false
    monochrome_logs = false
    hook_url = null
    logo = "${projectDir}/assets/MuSA_logo.png"
    help_full = false
    show_hidden = false
}

// Load nf-core custom profiles from different institutions
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


timeline {
  enabled = true
  file = "${params.outdir}/timeline.txt"
}

trace {
  enabled = true
  file = "${params.outdir}/trace.txt"
}

report {
  enabled = true
  file = "${params.outdir}/report.html"
}

dag {
  enabled = true
  file = "${params.outdir}/pipeline_dag.html"
}

process {
  cpus = 1
  memory = 4.GB
  time = 2.h

  // Database downloads take as long as the network needs: dbNSFP alone is 45 GB, and at the
  // few MB/s an institutional link gives it outlives the 2 h default, which killed it mid-
  // transfer ("process hasn't exited") at 83%. A retry would restart from zero in a new work
  // directory, so give them one long attempt instead.
  withName: 'DOWNLOAD_.*' {
    time = 72.h
  }
}

/**************************** Profiles ****************************/
profiles {
    test {
        params.input                 = "${projectDir}/tests/data/samplesheet.csv"
        params.outdir                = "output"
        params.use_vep_plugins       = false
        params.workflow              = "annotate"    
        params.vcf_format            = "multicaller"
        params.n_core                = 8
    }

    docker {
        docker.enabled = true
        // Conditional binding for ANNOVAR only if workflow is "annotate"
        process.containerOptions = "--user root -v ${params.data_dir}:/data ${params.workflow == 'annotate' && params.annovar_software_dir ? "-v ${params.annovar_software_dir}:/annovar" : ''} ${params.http_proxy ? "-e http_proxy=${params.http_proxy}" : ''} ${params.https_proxy ? "-e https_proxy=${params.https_proxy}" : ''}"
    }

    singularity {
        singularity.enabled = true
        // Conditional binding for ANNOVAR only if workflow is "annotate"
        process.containerOptions = "--bind ${params.data_dir}:/data ${params.workflow == 'annotate' && params.annovar_software_dir ? "--bind ${params.annovar_software_dir}:/annovar" : ''}"
    }

    podman {
        podman.enabled = true
        process.containerOptions = "--user root -v ${params.data_dir}:/data ${params.workflow == 'annotate' && params.annovar_software_dir ? "-v ${params.annovar_software_dir}:/annovar" : ''}"
    }
}

/**************************** Manifest ****************************************************/
manifest {
    name            = 'MuSA'
    contributors    = [
        // TODO nf-core: Update the field with the details of the contributors to your pipeline. New with Nextflow version 24.10.0
        [
            name: 'D. Scognamiglio, E. Bonetti',
            affiliation: 'IRCCS Istituto Ortopedico Rizzoli',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage = 'https://github.com/davide-scognamiglio/MuSA'
    description     = """Ultra-deep, multi-source variant annotation"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.0'
    version         = '1.0.0'
    doi             = '10.1186/s12859-026-06513-0'
}

/**************************** Configs ****************************************************/

/**************************** Tower ****************************************************/
tower {
    enabled = false
}

// Removed here: a hand-rolled check_max() helper and the max_cpus = 30 / max_memory = '60 GB' it
// read. Both were inert — check_max() was never called from any module or config, and those two
// assignments sat at top-level config scope rather than inside params {}, so params.max_cpus and
// params.max_memory were null and every branch of the helper would have fallen into its own
// "### ERROR ### ... is not valid!" catch had anything invoked it.
//
// Deliberately NOT replaced with Nextflow's `process.resourceLimits`. Those numbers never actually
// constrained anything, so enforcing them now would be a behaviour change, not a cleanup: a 60 GB
// ceiling would cap RENOVO_ANNOTATE_VCF's 72 GB retry (see that module) and reintroduce the OOM it
// exists to survive, and 30 cpus would throttle a 64-core host. If a real ceiling is wanted, set
// resourceLimits explicitly to the deployment's hardware.

// A personal dbNSFP link must not reach logs that users paste into issues.
validation {
    summary {
        hideParams = ["dbnsfp_url"]
    }
}

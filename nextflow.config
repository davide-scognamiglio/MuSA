
process.executor = "local"
plugins {
  id 'nf-schema@2.6.1'
}

/**************************** ANNOTATE parameters ****************************/
params {
    build                      = "hg38"
    dbs_manifest               = "https://raw.githubusercontent.com/davide-scognamiglio/test-datasets/refs/heads/main/dbs_manifest.yaml"
    input                      = null
    outdir                     = null
    workflow                   = null 
    vcf_format                 = null
    offline                    = true
    center                     = null
    annovar_software_dir       = null
    skip_bcftools              = false
    max_freq                   = null
    drop_benign                = false
    skip_genebe                = false
    panel                      = null
    // ------- GENEBE PARAMS - REQUIRED IF OFFLINE == FALSE -----------------------------------------------------------
    gb_user                    = null
    gb_api_key                 = null
    http_proxy                 = null
    https_proxy                = null
    // ------- VEP PARAMS ---------------------------------------------------------------------------------------------
    download_vep_plugins       = false
    use_vep_plugins            = false
    data_dir                   = null
    n_core                     = 8
    // ---------- OTHER -----------------------------------------------------------------------------------------------
    igenomes_base = 's3://ngi-igenomes/igenomes/'
    custom_config_version = 'master'
    custom_config_base = 'https://raw.githubusercontent.com/nf-core/configs/master'
    publish_dir_mode = 'copy'
    validate_params = true
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/davide-scognamiglio/test-datasets/'
    email = null
    genome = null
    fasta = null
    igenomes_ignore = false

    config_profile_name = null
    config_profile_description = null
    config_profile_contact = null
    config_profile_url = null

    version = false
    email_on_fail = null
    plaintext_email = false
    monochrome_logs = false
    hook_url = null
    logo = "${projectDir}/assets/MuSA_logo.png"
    help_full = false
    show_hidden = false
}

// Load nf-core custom profiles from different institutions
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


timeline {
  enabled = true
  file = "${params.outdir}/timeline.txt"
}

trace {
  enabled = true
  file = "${params.outdir}/trace.txt"
}

report {
  enabled = true
  file = "${params.outdir}/report.html"
}

dag {
  enabled = true
  file = "${params.outdir}/pipeline_dag.html"
}

process {
  cpus = 1
  memory = 4.GB
  time = 2.h
}

/**************************** Profiles ****************************/
profiles {
    test {
        params.input                 = "tests/data/samplesheet.csv"
        params.outdir                = "output"
        params.use_vep_plugins       = false
        params.workflow              = "annotate"    
        params.vcf_format            = "multicaller"
        params.n_core                = 8
    }

    docker {
        docker.enabled = true
        // Conditional binding for ANNOVAR only if workflow is "annotate"
        def annovar_bind = params.workflow == "annotate" && params.annovar_software_dir ? "-v ${params.annovar_software_dir}:/annovar" : ""
        process.containerOptions = "--user root -v ${params.data_dir}:/data ${annovar_bind} ${params.http_proxy ? "-e http_proxy=${params.http_proxy}" : ''} ${params.https_proxy ? "-e https_proxy=${params.https_proxy}" : ''}"
    }

    singularity {
        singularity.enabled = true
        // Conditional binding for ANNOVAR only if workflow is "annotate"
        def annovar_bind = params.workflow == "annotate" && params.annovar_software_dir ? "--bind ${params.annovar_software_dir}:/annovar" : ""
        process.containerOptions = "--bind ${params.data_dir}:/data ${annovar_bind}"
    }

    podman {
        podman.enabled = true
        def annovar_bind = params.workflow == "annotate" && params.annovar_software_dir ? "-v ${params.annovar_software_dir}:/annovar" : ""
        process.containerOptions = "--user root -v ${params.data_dir}:/data ${annovar_bind}"
    }
}

/**************************** Manifest ****************************************************/
manifest {
    name            = 'MuSA'
    contributors    = [
        // TODO nf-core: Update the field with the details of the contributors to your pipeline. New with Nextflow version 24.10.0
        [
            name: 'D. Scognamiglio, E. Bonetti',
            affiliation: 'IRCCS Istituto Ortopedico Rizzoli',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage = 'https://github.com/MuSA'
    description     = """Ultra-deep, multi-source variant annotation"""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=25.04.0'
    version         = '1.0.0dev'
    doi             = ''
}

/**************************** Configs ****************************************************/

/**************************** Tower ****************************************************/
tower {
    enabled = false
}

// Removed here: a hand-rolled check_max() helper and the max_cpus = 30 / max_memory = '60 GB' it
// read. Both were inert — check_max() was never called from any module or config, and those two
// assignments sat at top-level config scope rather than inside params {}, so params.max_cpus and
// params.max_memory were null and every branch of the helper would have fallen into its own
// "### ERROR ### ... is not valid!" catch had anything invoked it.
//
// Deliberately NOT replaced with Nextflow's `process.resourceLimits`. Those numbers never actually
// constrained anything, so enforcing them now would be a behaviour change, not a cleanup: a 60 GB
// ceiling would cap RENOVO_ANNOTATE_VCF's 72 GB retry (see that module) and reintroduce the OOM it
// exists to survive, and 30 cpus would throttle a 64-core host. If a real ceiling is wanted, set
// resourceLimits explicitly to the deployment's hardware.



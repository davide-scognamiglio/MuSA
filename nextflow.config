
process.executor = "local"
// Every MuSA module declares its own container. Clear any default a user set for all pipelines in
// ~/.nextflow/config (e.g. process.container = "ubuntu:22.04"): MuSA never uses it, and nf-schema's
// paramsSummaryLog crashes on a single default container ("Cannot cast object ... to class
// java.util.Map"), so it would stop MuSA before the first task.
process.container = null
plugins {
  id 'nf-schema@2.7.3'
}

/**************************** ANNOTATE parameters ****************************/
params {
    build                      = "hg38"
    // Pinned to the test-datasets commit this release was built for, not main: main follows the newest
    // MuSA (VEP cache, ANNOVAR entries), and a manifest written for a later release can break this one.
    dbs_manifest               = "https://raw.githubusercontent.com/davide-scognamiglio/test-datasets/2e466ef79f852fdebf1662e421e7c0edcced7e3b/dbs_manifest.yaml"
    update_db_only             = false
    // dbNSFP is distributed only to registered users (dbnsfp.org: institutional email, then a
    // personal download link), so the public manifest carries no URL for it. `setup` needs one of:
    //   --dbnsfp_url  your own dbNSFP download link (kept out of the parameter summary)
    //   --dbnsfp_zip  the dbNSFP zip already on disk (checked against the manifest's SHA-256)
    dbnsfp_url                 = null
    dbnsfp_zip                 = null
    input                      = null
    outdir                     = null
    workflow                   = null 
    vcf_format                 = null
    offline                    = true
    center                     = null
    annovar_software_dir       = null
    skip_bcftools              = false
    max_freq                   = null
    drop_benign                = false
    skip_genebe                = false
    panel                      = null
    // ------- GENEBE PARAMS - REQUIRED IF OFFLINE == FALSE -----------------------------------------------------------
    gb_user                    = null
    gb_api_key                 = null
    http_proxy                 = null
    https_proxy                = null
    // ------- VEP PARAMS ---------------------------------------------------------------------------------------------
    // The VEP image, declared once. VEP_ANNOTATE_VCF runs it and BUILD_ANNOTATE_REPORT prints its
    // tag as the annotation's provenance, so the two cannot drift: a report that names a VEP release
    // the run did not use is worse than a report that names none.
    //
    // The official upstream image, not a dsbioinfo retag: dsbioinfo/ensembl-vep:115.2 was a
    // straight retag of ensemblorg/ensembl-vep:release_115.2 (identical image ID), and 116 needed
    // no republish -- just pointing at Ensembl's own image. Verified before bumping: every plugin
    // .pm this pipeline uses ships unchanged in 116.2, and a real run against all of them produced
    // a byte-identical CSQ schema (same 151 fields) and identical values on the bundled test VCF.
    // The cache version must always match this tag's release -- see dbs_manifest.yaml's vep_cache.
    vep_container              = "ensemblorg/ensembl-vep:release_116.2"
    download_vep_plugins       = false
    use_vep_plugins            = false
    data_dir                   = null
    n_core                     = 8
    // ------- dbNSFP PER-CHROMOSOME SCATTER PARAMS --------------------------------------------------------------------
    // Measured on the 147-chunk ClinVar run (trace.txt): a shard task runs at a median 100% cpu, i.e.
    // one core, so asking for 2 reserved a core that never ran. dbNSFP needs only ~3.6 core-hours in
    // total (VEP needs ~34), yet maxForks=4 pushed 3.61h of work through 4 slots and set a ~54min
    // floor on an 80min run. The cap, not the box, was the bottleneck: 16 shards x 1 core leaves the
    // other 48 for VEP's 6 concurrent x 8.
    dbnsfp_shard_cpus          = 1
    dbnsfp_max_forks           = 16
    // How dbNSFP's per-transcript arrays reach the MAF. dbNSFP reports transcript-specific fields as
    // ';'-delimited arrays aligned with Ensembl_transcriptid (SIFT_score ".;0.169;0.169;."). Which
    // element belongs to the clinically canonical isoform is encoded ONLY in the MANE_dbNSFP array:
    // the offset of "Select" in ".;.;Select;." is the offset to read in every other array.
    //   "mane" (default) — collapse every transcript-aligned column to that element, so a score column
    //                      holds one number. MANE_dbNSFP then records whether a MANE was found at all.
    //   "all"            — leave the arrays untouched; MANE_dbNSFP is what indexes them downstream.
    dbnsfp_transcript_scores   = "mane"
    // ---------- OTHER -----------------------------------------------------------------------------------------------
    igenomes_base = 's3://ngi-igenomes/igenomes/'
    custom_config_version = 'master'
    custom_config_base = 'https://raw.githubusercontent.com/nf-core/configs/master'
    publish_dir_mode = 'copy'
    validate_params = true
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/davide-scognamiglio/test-datasets/'
    email = null
    genome = null
    fasta = null
    igenomes_ignore = false

    config_profile_name = null
    config_profile_description = null
    config_profile_contact = null
    config_profile_url = null

    version = false
    email_on_fail = null
    plaintext_email = false
    monochrome_logs = false
    hook_url = null
    logo = "${projectDir}/assets/MuSA_logo.png"
    help = false
    help_full = false
    show_hidden = false
}

// Load nf-core custom profiles from different institutions
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// nf-core lint warns that the pipeline-specific institutional config is not included, i.e. a
// second includeConfig for "${params.custom_config_base}/pipeline/MuSA.config". That line is
// deliberately absent: it only works once the pipeline has a config in nf-core/configs.
// nf-core/configs master/pipeline/sarek.config returns 200; .../pipeline/MuSA.config returns 404,
// so adding it would make every online run try to include a URL that does not exist.
// Add it in the same change that lands MuSA in nf-core/configs, not before.


timeline {
  enabled = true
  file = "${params.outdir}/timeline.txt"
  overwrite = true
}

trace {
  enabled = true
  file = "${params.outdir}/trace.txt"
  overwrite = true
}

report {
  enabled = true
  file = "${params.outdir}/report.html"
  overwrite = true
}

dag {
  enabled = true
  file = "${params.outdir}/pipeline_dag.html"
  overwrite = true
}

process {
  cpus = 1
  memory = 4.GB
  time = 2.h

  // Database downloads take as long as the network needs: dbNSFP alone is 45 GB, and at the
  // few MB/s an institutional link gives it outlives the 2 h default, which killed it mid-
  // transfer ("process hasn't exited") at 83%. A retry would restart from zero in a new work
  // directory, so give them one long attempt instead.
  withName: 'DOWNLOAD_.*' {
    time = 72.h
  }
}

/**************************** Profiles ****************************/
profiles {
    // These live in conf/ rather than inline: nf-core lint requires conf/test.config and
    // conf/test_full.config to exist, and having the real profile inline while those files sat
    // unincluded meant they drifted into pure template residue (they still pointed at
    // viralrecon samplesheets and a yeast genome, and conf/test.config carried a stray
    // 15 GB process.resourceLimits that would have capped RENOVO_ANNOTATE_VCF's 72 GB retry
    // had anything ever included it).
    test {
        includeConfig 'conf/test.config'
    }

    test_full {
        includeConfig 'conf/test_full.config'
    }

    docker {
        docker.enabled = true
        // Conditional binding for ANNOVAR only if workflow is "annotate"
        process.containerOptions = "--user root -v ${params.data_dir}:/data ${params.workflow == 'annotate' && params.annovar_software_dir ? "-v ${params.annovar_software_dir}:/annovar" : ''} ${params.http_proxy ? "-e http_proxy=${params.http_proxy}" : ''} ${params.https_proxy ? "-e https_proxy=${params.https_proxy}" : ''}"
    }

    singularity {
        singularity.enabled = true
        // Conditional binding for ANNOVAR only if workflow is "annotate"
        process.containerOptions = "--bind ${params.data_dir}:/data ${params.workflow == 'annotate' && params.annovar_software_dir ? "--bind ${params.annovar_software_dir}:/annovar" : ''}"
    }

    podman {
        podman.enabled = true
        process.containerOptions = "--user root -v ${params.data_dir}:/data ${params.workflow == 'annotate' && params.annovar_software_dir ? "-v ${params.annovar_software_dir}:/annovar" : ''}"
    }
}

/**************************** Schema validation / help ************************************/
// Without this block nf-schema never intercepts --help: main.nf calls validateParameters() at the
// top, so `nextflow run MuSA --help` used to die with "Missing required parameter(s)" instead of
// printing anything. docs/usage.md tells users to run --help, so it has to work.
validation {
    monochromeLogs      = params.monochrome_logs
    // A personal dbNSFP link must not reach logs that users paste into issues.
    summary {
        hideParams      = ["dbnsfp_url"]
    }
    help {
        enabled             = true
        command             = "nextflow run MuSA --workflow annotate --input samplesheet.csv --outdir <OUTDIR> --data_dir <DATA_DIR> --annovar_software_dir <ANNOVAR_DIR> -profile docker"
        fullParameter       = "help_full"
        showHiddenParameter = "show_hidden"
    }
}

/**************************** Manifest ****************************************************/
manifest {
    // "<owner>/<repo>" form. Nextflow uses it to resolve `nextflow run <name>` / `nextflow pull
    // <name>`, and nf-core tooling hard-requires the slash: nf_core/utils.py does
    // `prefix, name = manifest.name.split("/")` unguarded, so a bare 'MuSA' crashed every lint run
    // before a single test executed. Nothing in the pipeline itself reads manifest.name.
    // On the day MuSA is adopted by nf-core this becomes 'nf-core/musa'.
    name            = 'davide-scognamiglio/MuSA'
    // Roles follow the author-contributions statement of the MuSA paper (BMC Bioinformatics 2026;
    // 27(1):199). ORCIDs and per-author emails/handles are left blank where not known — fill them
    // in rather than guessing.
    contributors    = [
        [
            name: 'D. Scognamiglio',
            affiliation: 'Alma Mater Studiorum Università di Bologna; IRCCS Istituto Ortopedico Rizzoli',
            email: 'davide.scognamiglio@ior.it',
            github: 'davide-scognamiglio',
            contribution: ['author', 'maintainer'],
            orcid: ''
        ],
        [
            name: 'E. Bonetti',
            affiliation: 'IRCCS Istituto Ortopedico Rizzoli',
            email: '',
            github: '',
            contribution: ['author'],
            orcid: ''
        ],
        [
            name: 'A. Moroni',
            affiliation: 'IRCCS Istituto Ortopedico Rizzoli',
            email: '',
            github: '',
            contribution: ['contributor'],
            orcid: ''
        ],
        [
            name: 'L. Sangiorgi',
            affiliation: 'IRCCS Istituto Ortopedico Rizzoli',
            email: '',
            github: '',
            contribution: ['contributor'],
            orcid: ''
        ],
        [
            name: 'E. Pedrini',
            affiliation: 'IRCCS Istituto Ortopedico Rizzoli',
            email: '',
            github: '',
            contribution: ['contributor'],
            orcid: ''
        ],
    ]
    homePage = 'https://github.com/davide-scognamiglio/MuSA'
    description     = """Ultra-deep, multi-source variant annotation"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.0'
    version         = '1.1.0'
    doi             = '10.1186/s12859-026-06513-0'
}

/**************************** Configs ****************************************************/

/**************************** Tower ****************************************************/
tower {
    enabled = false
}

// Removed here: a hand-rolled check_max() helper and the max_cpus = 30 / max_memory = '60 GB' it
// read. Both were inert — check_max() was never called from any module or config, and those two
// assignments sat at top-level config scope rather than inside params {}, so params.max_cpus and
// params.max_memory were null and every branch of the helper would have fallen into its own
// "### ERROR ### ... is not valid!" catch had anything invoked it.
//
// Deliberately NOT replaced with Nextflow's `process.resourceLimits`. Those numbers never actually
// constrained anything, so enforcing them now would be a behaviour change, not a cleanup: a 60 GB
// ceiling would cap RENOVO_ANNOTATE_VCF's 72 GB retry (see that module) and reintroduce the OOM it
// exists to survive, and 30 cpus would throttle a 64-core host. If a real ceiling is wanted, set
// resourceLimits explicitly to the deployment's hardware.


